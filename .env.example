# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_KEY: (Optional/Recommended for Passcode Officer Login)
# Paste the JSON content of your Firebase Service Account key here (in AI Studio Secrets)
# to enable server-side Passcode verification and officer CMS operations via Firebase Admin SDK.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# SESSION_SECRET: (Optional) Secret key for signing HttpOnly Passcode officer session cookies.
SESSION_SECRET=""

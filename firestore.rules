rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(emailId) {
      return emailId is string && emailId.size() >= 5 && emailId.size() <= 200 && emailId.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function isSuperAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email.lower() == 'datday1995@gmail.com' ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.status == 'active' &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'super_admin'
        )
      );
    }

    function isEditorAdmin() {
      return isSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.status == 'active' &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role in ['super_admin', 'editor']
      );
    }

    function isViewerOrAdmin() {
      return isEditorAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.status == 'active' &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'viewer'
      );
    }

    // --- Entity Validation Blueprints ---
    function isValidArticle(data) {
      return data.keys().hasAll([
        'title', 'slug', 'categoryId', 'categoryName', 'sectionType',
        'shortDescription', 'coverImage', 'contentHtml', 'attachments',
        'keywords', 'status', 'publishedDate', 'authorId', 'authorName',
        'isSample', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'slug', 'categoryId', 'categoryName', 'sectionType',
        'shortDescription', 'coverImage', 'contentHtml', 'attachments',
        'keywords', 'status', 'publishedDate', 'authorId', 'authorName',
        'isSample', 'createdAt', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 240 &&
      data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 180 && data.slug.matches('^[a-z0-9-]+$') &&
      data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 128 && data.categoryId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 120 &&
      data.sectionType in ['procedure', 'guide', 'news'] &&
      data.shortDescription is string && data.shortDescription.size() <= 600 &&
      data.coverImage is string && data.coverImage.size() <= 2048 &&
      data.contentHtml is string && data.contentHtml.size() <= 500000 &&
      data.attachments is list && data.attachments.size() <= 20 &&
      (data.attachments.size() == 0 || (data.attachments[0] is map && data.attachments[0].name is string && data.attachments[0].url is string)) &&
      data.keywords is list && data.keywords.size() <= 15 &&
      (data.keywords.size() == 0 || (data.keywords[0] is string && data.keywords[0].size() <= 60)) &&
      data.status in ['draft', 'published', 'hidden'] &&
      data.publishedDate is string && data.publishedDate.size() >= 4 && data.publishedDate.size() <= 40 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
      data.isSample is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidProcedureGuide(data) {
      return data.keys().hasAll([
        'title', 'slug', 'cardOrder', 'isCoreCard', 'iconKey', 'groupKey',
        'shortDescription', 'intro', 'targetAudience', 'conditions',
        'dossierItems', 'dossierQuantity', 'submissionMethods', 'receivingLocation',
        'steps', 'processingTime', 'fees', 'result', 'legalBasis', 'forms',
        'faqs', 'subCases', 'referenceNotes', 'onlinePortalUrl', 'keywords',
        'status', 'isVerifiedSeed', 'authorId', 'authorName', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'slug', 'cardOrder', 'isCoreCard', 'iconKey', 'groupKey',
        'shortDescription', 'intro', 'targetAudience', 'conditions',
        'dossierItems', 'dossierQuantity', 'submissionMethods', 'receivingLocation',
        'steps', 'processingTime', 'fees', 'result', 'legalBasis', 'forms',
        'faqs', 'subCases', 'referenceNotes', 'onlinePortalUrl', 'keywords',
        'status', 'isVerifiedSeed', 'authorId', 'authorName', 'createdAt', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 240 &&
      data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 180 && data.slug.matches('^[a-z0-9-]+$') &&
      data.cardOrder is number && data.cardOrder >= 0 && data.cardOrder <= 1000 &&
      data.isCoreCard is bool &&
      data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
      data.groupKey in ['cap-lan-dau', 'doi-gplx', 'cap-lai-gplx', 'phuc-hoi-diem', 'sat-hach-qua-han', 'gplx-quoc-te'] &&
      data.shortDescription is string && data.shortDescription.size() <= 600 &&
      data.intro is string && data.intro.size() <= 4000 &&
      data.targetAudience is string && data.targetAudience.size() <= 4000 &&
      data.conditions is string && data.conditions.size() <= 6000 &&
      data.dossierItems is list && data.dossierItems.size() <= 30 &&
      data.dossierQuantity is string && data.dossierQuantity.size() <= 300 &&
      data.submissionMethods is list && data.submissionMethods.size() <= 15 &&
      data.receivingLocation is string && data.receivingLocation.size() <= 1200 &&
      data.steps is list && data.steps.size() <= 20 &&
      data.processingTime is string && data.processingTime.size() <= 1200 &&
      data.fees is string && data.fees.size() <= 1200 &&
      data.result is string && data.result.size() <= 1200 &&
      data.legalBasis is list && data.legalBasis.size() <= 30 &&
      data.forms is list && data.forms.size() <= 20 &&
      data.faqs is list && data.faqs.size() <= 30 &&
      data.subCases is list && data.subCases.size() <= 20 &&
      data.referenceNotes is string && data.referenceNotes.size() <= 4000 &&
      data.onlinePortalUrl is string && data.onlinePortalUrl.size() <= 1000 &&
      data.keywords is list && data.keywords.size() <= 25 &&
      data.status in ['draft', 'published', 'hidden'] &&
      data.isVerifiedSeed is bool &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLegalDocument(data) {
      return data.keys().hasAll([
        'docNumber', 'title', 'docType', 'issuedDate', 'effectiveDate',
        'issuingAuthority', 'validityStatus', 'summary', 'pdfUrl',
        'relatedProcedureSlugs', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'docNumber', 'title', 'docType', 'issuedDate', 'effectiveDate',
        'issuingAuthority', 'validityStatus', 'summary', 'pdfUrl',
        'relatedProcedureSlugs', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.docNumber is string && data.docNumber.size() >= 2 && data.docNumber.size() <= 100 &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 400 &&
      data.docType in ['law', 'decree', 'circular', 'decision', 'form', 'guide'] &&
      data.issuedDate is string && data.issuedDate.size() <= 80 &&
      data.effectiveDate is string && data.effectiveDate.size() <= 80 &&
      data.issuingAuthority is string && data.issuingAuthority.size() <= 200 &&
      data.validityStatus in ['effective', 'amended', 'expired', 'verifying'] &&
      data.summary is string && data.summary.size() <= 2000 &&
      data.pdfUrl is string && data.pdfUrl.size() <= 2048 &&
      data.relatedProcedureSlugs is list && data.relatedProcedureSlugs.size() <= 20 &&
      data.status in ['draft', 'published', 'hidden'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidFaqItem(data) {
      return data.keys().hasAll([
        'question', 'answer', 'category', 'relatedProcedureSlug', 'legalRef',
        'order', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'question', 'answer', 'category', 'relatedProcedureSlug', 'legalRef',
        'order', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.question is string && data.question.size() >= 4 && data.question.size() <= 500 &&
      data.answer is string && data.answer.size() >= 4 && data.answer.size() <= 4000 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
      data.relatedProcedureSlug is string && data.relatedProcedureSlug.size() <= 180 &&
      data.legalRef is string && data.legalRef.size() <= 400 &&
      data.order is number && data.order >= 0 && data.order <= 10000 &&
      data.status in ['draft', 'published', 'hidden'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'description', 'order', 'isVisible', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['name', 'slug', 'description', 'order', 'isVisible', 'createdAt', 'updatedAt']) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
      data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9-]+$') &&
      data.description is string && data.description.size() <= 400 &&
      data.order is number && data.order >= 0 && data.order <= 10000 &&
      data.isVisible is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
        'siteTitle', 'agencyName', 'departmentName', 'logoUrl', 'bannerUrl',
        'bannerTitle', 'bannerSubtitle', 'address', 'phone', 'facebookUrl',
        'websiteUrl', 'introContent', 'footerNote', 'mapEmbedUrl', 'updatedBy', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'siteTitle', 'agencyName', 'departmentName', 'logoUrl', 'bannerUrl',
        'bannerTitle', 'bannerSubtitle', 'address', 'phone', 'facebookUrl',
        'websiteUrl', 'introContent', 'footerNote', 'mapEmbedUrl', 'updatedBy', 'updatedAt'
      ]) &&
      data.siteTitle is string && data.siteTitle.size() >= 2 && data.siteTitle.size() <= 200 &&
      data.agencyName is string && data.agencyName.size() >= 2 && data.agencyName.size() <= 160 &&
      data.departmentName is string && data.departmentName.size() >= 2 && data.departmentName.size() <= 160 &&
      data.logoUrl is string && data.logoUrl.size() <= 2048 &&
      data.bannerUrl is string && data.bannerUrl.size() <= 2048 &&
      data.bannerTitle is string && data.bannerTitle.size() <= 200 &&
      data.bannerSubtitle is string && data.bannerSubtitle.size() <= 500 &&
      data.address is string && data.address.size() <= 300 &&
      data.phone is string && data.phone.size() <= 40 &&
      data.facebookUrl is string && data.facebookUrl.size() <= 500 &&
      data.websiteUrl is string && data.websiteUrl.size() <= 500 &&
      data.introContent is string && data.introContent.size() <= 5000 &&
      data.footerNote is string && data.footerNote.size() <= 500 &&
      data.mapEmbedUrl is string && data.mapEmbedUrl.size() <= 1000 &&
      data.updatedBy is string && data.updatedBy.size() <= 128 &&
      data.updatedAt is timestamp;
    }

    function isValidPasscodeAccount(data) {
      return data.keys().hasAll([
        'ownerName', 'passcodeHash', 'note', 'status', 'failedAttempts',
        'lockedUntil', 'lastLoginAt', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerName', 'passcodeHash', 'note', 'status', 'failedAttempts',
        'lockedUntil', 'lastLoginAt', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 120 &&
      data.passcodeHash is string && data.passcodeHash.size() >= 32 && data.passcodeHash.size() <= 512 &&
      data.note is string && data.note.size() <= 500 &&
      data.status in ['active', 'locked'] &&
      data.failedAttempts is number && data.failedAttempts >= 0 && data.failedAttempts <= 100 &&
      data.lockedUntil is string && data.lockedUntil.size() <= 64 &&
      data.lastLoginAt is string && data.lastLoginAt.size() <= 64 &&
      data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'status', 'addedBy', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['email', 'displayName', 'role', 'status', 'addedBy', 'createdAt', 'updatedAt']) &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 200 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.role in ['super_admin', 'editor', 'viewer'] &&
      data.status in ['active', 'revoked'] &&
      data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['name', 'url', 'storagePath', 'mimeType', 'sizeBytes', 'kind', 'uploadedBy', 'uploadedByName', 'createdAt']) &&
      data.keys().hasOnly(['name', 'url', 'storagePath', 'mimeType', 'sizeBytes', 'kind', 'uploadedBy', 'uploadedByName', 'createdAt']) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 240 &&
      data.url is string && data.url.size() >= 1 && data.url.size() <= 2048 &&
      data.storagePath is string && data.storagePath.size() <= 512 &&
      data.mimeType is string && data.mimeType.size() <= 120 &&
      data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 52428800 &&
      data.kind in ['image', 'document'] &&
      data.uploadedBy is string && data.uploadedBy.size() >= 1 && data.uploadedBy.size() <= 128 &&
      data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 120 &&
      data.createdAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['actorName', 'actorType', 'actorId', 'action', 'targetType', 'targetTitle', 'details', 'createdAt']) &&
      data.keys().hasOnly(['actorName', 'actorType', 'actorId', 'action', 'targetType', 'targetTitle', 'details', 'createdAt']) &&
      data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
      data.actorType in ['google_admin', 'passcode_officer'] &&
      data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 200 &&
      data.action is string && data.action.size() >= 1 && data.action.size() <= 120 &&
      data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 60 &&
      data.targetTitle is string && data.targetTitle.size() <= 240 &&
      data.details is string && data.details.size() <= 600 &&
      data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    match /articles/{articleId} {
      allow get: if isValidId(articleId) && (existing().status == 'published' || isViewerOrAdmin());
      allow list: if resource.data.status == 'published' || isViewerOrAdmin();
      allow create: if isValidId(articleId) &&
        isEditorAdmin() &&
        isValidArticle(incoming()) &&
        exists(/databases/$(database)/documents/categories/$(incoming().categoryId)) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(articleId) &&
        isEditorAdmin() &&
        isValidArticle(incoming()) &&
        exists(/databases/$(database)/documents/categories/$(incoming().categoryId)) &&
        incoming().createdAt == existing().createdAt &&
        incoming().authorId == existing().authorId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'categoryId', 'categoryName', 'sectionType',
          'shortDescription', 'coverImage', 'contentHtml', 'attachments',
          'keywords', 'status', 'publishedDate', 'isSample', 'updatedAt'
        ]);
      allow delete: if isValidId(articleId) && isEditorAdmin();
    }

    match /procedures/{procedureId} {
      allow get: if isValidId(procedureId) && (existing().status == 'published' || isViewerOrAdmin());
      allow list: if resource.data.status == 'published' || isViewerOrAdmin();
      allow create: if isValidId(procedureId) &&
        isEditorAdmin() &&
        isValidProcedureGuide(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(procedureId) &&
        isEditorAdmin() &&
        isValidProcedureGuide(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().authorId == existing().authorId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'cardOrder', 'isCoreCard', 'iconKey', 'groupKey',
          'shortDescription', 'intro', 'targetAudience', 'conditions',
          'dossierItems', 'dossierQuantity', 'submissionMethods', 'receivingLocation',
          'steps', 'processingTime', 'fees', 'result', 'legalBasis', 'forms',
          'faqs', 'subCases', 'referenceNotes', 'onlinePortalUrl', 'keywords',
          'status', 'isVerifiedSeed', 'updatedAt'
        ]);
      allow delete: if isValidId(procedureId) && isEditorAdmin();
    }

    match /legalDocuments/{docId} {
      allow get: if isValidId(docId) && (existing().status == 'published' || isViewerOrAdmin());
      allow list: if resource.data.status == 'published' || isViewerOrAdmin();
      allow create: if isValidId(docId) &&
        isEditorAdmin() &&
        isValidLegalDocument(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(docId) &&
        isEditorAdmin() &&
        isValidLegalDocument(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().authorId == existing().authorId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'docNumber', 'title', 'docType', 'issuedDate', 'effectiveDate',
          'issuingAuthority', 'validityStatus', 'summary', 'pdfUrl',
          'relatedProcedureSlugs', 'status', 'updatedAt'
        ]);
      allow delete: if isValidId(docId) && isEditorAdmin();
    }

    match /faqs/{faqId} {
      allow get: if isValidId(faqId) && (existing().status == 'published' || isViewerOrAdmin());
      allow list: if resource.data.status == 'published' || isViewerOrAdmin();
      allow create: if isValidId(faqId) &&
        isEditorAdmin() &&
        isValidFaqItem(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(faqId) &&
        isEditorAdmin() &&
        isValidFaqItem(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().authorId == existing().authorId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'question', 'answer', 'category', 'relatedProcedureSlug', 'legalRef',
          'order', 'status', 'updatedAt'
        ]);
      allow delete: if isValidId(faqId) && isEditorAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (existing().isVisible == true || isViewerOrAdmin());
      allow list: if resource.data.isVisible == true || isViewerOrAdmin();
      allow create: if isValidId(categoryId) &&
        isEditorAdmin() &&
        isValidCategory(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId) &&
        isEditorAdmin() &&
        isValidCategory(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'order', 'isVisible', 'updatedAt']);
      allow delete: if isValidId(categoryId) && isEditorAdmin();
    }

    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create: if isValidId(settingId) &&
        isSuperAdmin() &&
        isValidSiteSettings(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) &&
        isSuperAdmin() &&
        isValidSiteSettings(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'siteTitle', 'agencyName', 'departmentName', 'logoUrl', 'bannerUrl',
          'bannerTitle', 'bannerSubtitle', 'address', 'phone', 'facebookUrl',
          'websiteUrl', 'introContent', 'footerNote', 'mapEmbedUrl', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /passcodes/{passcodeId} {
      allow get: if isValidId(passcodeId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(passcodeId) &&
        isSuperAdmin() &&
        isValidPasscodeAccount(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(passcodeId) &&
        isSuperAdmin() &&
        isValidPasscodeAccount(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName', 'passcodeHash', 'note', 'status', 'failedAttempts',
          'lockedUntil', 'lastLoginAt', 'updatedAt'
        ]);
      allow delete: if isValidId(passcodeId) && isSuperAdmin();
    }

    match /admins/{adminEmail} {
      allow get: if isValidEmailId(adminEmail) && (isSuperAdmin() || (isVerifiedUser() && request.auth.token.email.lower() == adminEmail));
      allow list: if isSuperAdmin();
      allow create: if isValidEmailId(adminEmail) &&
        isSuperAdmin() &&
        isValidAdminUser(incoming()) &&
        incoming().email == adminEmail &&
        incoming().addedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidEmailId(adminEmail) &&
        isSuperAdmin() &&
        isValidAdminUser(incoming()) &&
        incoming().email == existing().email &&
        incoming().addedBy == existing().addedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'status', 'updatedAt']);
      allow delete: if isValidEmailId(adminEmail) && isSuperAdmin();
    }

    match /media/{mediaId} {
      allow get: if isValidId(mediaId) && isViewerOrAdmin();
      allow list: if isViewerOrAdmin();
      allow create: if isValidId(mediaId) &&
        isEditorAdmin() &&
        isValidMediaAsset(incoming()) &&
        incoming().uploadedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(mediaId) && isEditorAdmin();
    }

    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(logId) &&
        isEditorAdmin() &&
        isValidActivityLog(incoming()) &&
        incoming().actorId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
